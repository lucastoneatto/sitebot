# PostgreSQL (pgvector). Levanta con: docker compose up -d db
DATABASE_URL=postgres://bot:bot@localhost:5432/bot

# Auth
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# Chat (OpenAI-compatible). Cambia CHAT_BASE_URL para DeepSeek/Groq/Together
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
CHAT_BASE_URL=https://api.openai.com/v1
# Corte relativo al mejor resultado en la recuperacion (ver keepRelevant).
CHAT_RELATIVE_MARGIN=0.02

# Embeddings: "local" (e5-small en CPU, gratis) o "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# API
API_PORT=3001
API_URL=http://localhost:3001
# Si es true, /chat no valida el Origin (solo desarrollo)
CORS_RELAXED=false

# Crawl
# Chromium para sitios que renderizan con JS. false = imagen mucho mas ligera.
CRAWL_RENDER_JS=true
# Dias que se conservan las conversaciones (0 = para siempre).
CONVERSATION_RETENTION_DAYS=180
CRAWL_MAX_PAGES=20
CRAWL_MAX_DEPTH=2
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP=150
# Si es true, permite crawlear IPs privadas (solo desarrollo)
CRAWL_ALLOW_PRIVATE=false

# Orígenes del dashboard que siempre pueden usar /chat
DASHBOARD_ORIGINS=http://localhost:3000

# Precios por 1M tokens (para el cálculo de gastos de IA).
# gpt-4o-mini: $0.15 input / $0.60 output · text-embedding-3-small: $0.02
PRICE_CHAT_INPUT_PER_M=0.15
PRICE_CHAT_OUTPUT_PER_M=0.60
PRICE_EMBEDDING_PER_M=0.02

# Seed de admin (opcional)
SEED_ADMIN_EMAIL=admin@sitebot.local
SEED_ADMIN_PASSWORD=password1234

# --- Panel de operador (/admin) ---
# Basic auth del panel del dueño de la plataforma.
# Obligatorio en producción: la API no arranca sin esto (password de 12+ caracteres).
ADMIN_USER=owner
ADMIN_PASSWORD=cambia-esta-password-larga

# --- Cola de crawls (BullMQ + Dragonfly) ---
# Dragonfly habla el protocolo Redis; levanta con: docker compose up -d dragonfly
REDIS_URL=redis://localhost:6379
# Nº de páginas procesadas en paralelo por el worker, GLOBAL entre todos los
# sitios (cada página es su propio job de BullMQ).
CRAWL_PAGE_CONCURRENCY=8

# --- Dashboard de colas (/admin/queues) ---
# Basic auth propio; si se omite, usa ADMIN_USER/ADMIN_PASSWORD.
# Obligatorio en producción: la API no arranca sin esto (password de 12+ caracteres).
BULL_BOARD_USER=owner
BULL_BOARD_PASSWORD=cambia-esta-password-larga
