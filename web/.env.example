# URL pública del API (la que verá el navegador y el snippet embebido)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL interna que usa el servidor de Next para hablar con el API.
# En docker compose se sobreescribe a http://api:3001
API_URL=http://localhost:3001

# Credenciales del panel /admin. Deben coincidir con las del API.
# Se usan solo en el servidor de Next; nunca llegan al navegador.
ADMIN_USER=owner
ADMIN_PASSWORD=cambia-esta-password-larga
